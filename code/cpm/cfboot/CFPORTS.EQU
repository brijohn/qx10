;
;  Compact Flash I/O Ports
;
CFDAT	EQU	0D0H ; CF DATA REG
CFERR	EQU	0D1H ; CF ERROR REG
CFFTR	EQU	0D1H ; CF FEATURE REG
CFCNT	EQU	0D2H ; CF SECTOR COUNT REG
CFSEC	EQU	0D3H ; CF SECTOR REG
CFCLO	EQU	0D4H ; CF CYLINDER LOW REG
CFCHI	EQU	0D5H ; CF CYLINDER HIGH REG
CFSDH	EQU	0D6H ; CF DRIVE/HEAD REG
CFSTA	EQU	0D7H ; CF STATUS REG
CFCMD	EQU	0D7H ; CF COMMAND REG
